<li><strong>Teste-toi avant de vérifier</strong> : cache la carte, écris le kanji depuis le mot de vocabulaire seul, puis compare.</li>
<li><strong>Ce soir, rappel espacé</strong> : « on l'a vu tout à l'heure, une fois de plus » — pas une relecture, une récupération.</li>
</ol>
</div>
"""

REG_MAP = {
    "○": ("casual", "reg-casual"),
    "◇": ("neutre", "reg-neutre"),
    "◆": ("formel", "reg-formel"),
}


def esc(s):
    if s is None:
        return ""
    return str(s)


def render_root(r):
    unlocks = " · ".join(r.get("unlocks", []))
    link = r.get("card_link")
    kanji_html = f'<a href="{esc(link)}">{esc(r["kanji"])}</a>' if link else esc(r["kanji"])
    return (f'<div class="root"><div class="kanji">{kanji_html}</div>'
            f'<div class="reading">{esc(r.get("kun",""))}{" · " if r.get("kun") and r.get("on") else ""}{esc(r.get("on",""))}</div>'
            f'<div class="meaning">{esc(r.get("meaning",""))}</div>'
            f'<div class="unlocks">→ {unlocks}</div></div>')


def render_item(it):
    reg = it.get("register")
    reg_html = ""
    if reg and reg in REG_MAP:
        label, cls = REG_MAP[reg]
        reg_html = f'<span class="reg {cls}">{reg} {label}</span>'
    kana = f'<span class="kana">（{esc(it["kana"])}）</span>' if it.get("kana") else ""
    note = f' <span class="note">{esc(it["note"])}</span>' if it.get("note") else ""
    romaji = f'<span class="romaji">{esc(it["romaji"])}</span>' if it.get("romaji") else ""
    lit = f'<span class="lit">litt. : {esc(it["lit"])}</span>' if it.get("lit") else ""
    manual = f'<span class="manual">forme manuel : {esc(it["manual"])}</span>' if it.get("manual") else ""
    poli = f'<span class="poli">poli : {esc(it["poli"])}</span>' if it.get("poli") else ""
    dial = f'<span class="dial">{esc(it["dial"])}</span>' if it.get("dial") else ""
    return (f'<div class="item"><span class="jp">{esc(it["jp"])}</span>{kana}{romaji}{reg_html}'
            f'<span class="meaning">{esc(it["meaning"])}{note}</span>{lit}{manual}{poli}{dial}</div>')


def render_kanji_card(k, open_default=False):
    stroke_svg, n = fetch_stroke_svg(k["char"])
    strokes_html = (f'<div class="kcard-strokes">{stroke_svg}</div>' if stroke_svg
                     else '<div class="kcard-strokes" style="color:#999;font-size:.82rem">(tracé indisponible hors ligne)</div>')
    op = " open" if open_default else ""
    vocab = f'{esc(k.get("vocab_jp",""))}' + (f'<span class="kana">（{esc(k["vocab_kana"])}）</span>' if k.get("vocab_kana") else "")
    return (
        f'<details class="kcard"{op}>'
        f'<summary><span class="kanji">{esc(k["char"])}</span>'
        f'<span class="vocab">{vocab}</span>'
        f'<span class="meaning">{esc(k.get("vocab_fr",""))}</span></summary>'
        f'<div class="kcard-body">'
        f'<div class="kcard-meta"><span><strong>ON</strong> {esc(k.get("on","—"))}</span>'
        f'<span><strong>KUN</strong> {esc(k.get("kun","—"))}</span>'
        f'<span><strong>Radical</strong> {esc(k.get("radical",""))}</span>'
        f'{f"<span><strong>{n} traits</strong></span>" if n else ""}</div>'
        f'{strokes_html}'
        f'<div class="kcard-mnemo">{k.get("mnemo","")}</div>'
        f'</div></details>'
    )


def render_group(g, open_default=True):
    items_html = "\n".join(render_item(it) for it in g["items"])
    n = len(g["items"])
    op = " open" if g.get("open", open_default) else ""
    return (f'<details class="group"{op}><summary>{esc(g["name"])} <span style="color:#999;font-weight:400">'
            f'{n}</span></summary><div class="group-body">{items_html}</div></details>')


def build_html(spec):
    title = spec["title"]
    subtitle = spec.get("subtitle", "")
    legend = spec.get("legend", "")
    roots = spec.get("roots", [])
    groups = spec.get("groups", [])
    kanji_cards = spec.get("kanji_cards", [])

    roots_html = ""
    if roots:
        roots_html = f'<div class="roots">{"".join(render_root(r) for r in roots)}</div>'

    kcards_html = ""
    if kanji_cards:
        cards = "".join(render_kanji_card(k, open_default=(i == 0)) for i, k in enumerate(kanji_cards))
        kcards_html = STUDY_PROTOCOL_HTML + f'<div class="kcards">{cards}</div>'

    groups_html = "\n".join(render_group(g) for g in groups)

    legend_html = ""
    if legend:
        legend_html = f'<div class="legend"><span>{esc(legend)}</span></div>'

    return f"""<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{esc(title)}</title>
<style>{CSS}</style></head>
<body>
<header><h1>{esc(title)}</h1><div class="subtitle">{esc(subtitle)}</div>{legend_html}</header>
{roots_html}
{kcards_html}
{groups_html}
<footer>Généré via lesson-card-html + kanji-stroke-order-html — Memory/Japanese</footer>
</body></html>
"""


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: python3 generate_lesson_card.py spec.json")
    with open(sys.argv[1], encoding="utf-8") as f:
        spec = json.load(f)

    out_dir = spec.get("out_dir") or _DEFAULT_OUTDIR
    if not os.path.isabs(out_dir):
        out_dir = os.path.join(_DEFAULT_OUTDIR, out_dir)
    os.makedirs(out_dir, exist_ok=True)

    fname = (spec.get("file") or re.sub(r"[^\w\-]+", "_", spec["title"])) + ".html"
    path = os.path.join(out_dir, fname)
    html = build_html(spec)
    with open(path, "w", encoding="utf-8") as f:
        f.write(html)

    n_items = sum(len(g["items"]) for g in spec.get("groups", []))
    n_kcards = len(spec.get("kanji_cards", []))
    print(f"{spec['title']} -> {len(spec.get('roots', []))} racines + {n_kcards} kanji_cards (tracés inlinés) + {n_items} mots -> {path}")


if __name__ == "__main__":
    main()
