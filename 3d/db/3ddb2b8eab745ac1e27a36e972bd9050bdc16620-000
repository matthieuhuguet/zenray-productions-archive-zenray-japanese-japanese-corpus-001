# --- Fusion avec kanji-stroke-order-html : tracés KanjiVG inlinés dans la fiche
# de leçon elle-même (jamais de fichier .md, jamais de lien externe). Logique
# dupliquée (pas importée) pour que chaque skill reste auto-suffisant.
KANJIVG_URL = "https://raw.githubusercontent.com/KanjiVG/kanjivg/master/kanji/{cp}.svg"


def _codepoint(char):
    return format(ord(char), "05x")


def _parse_paths(svg):
    return re.findall(r'<path[^>]*\bd="([^"]+)"', svg)


def _parse_numbers(svg):
    out = []
    for m in re.finditer(r'<text[^>]*transform="matrix\(1 0 0 1 ([\d.]+) ([\d.]+)\)"', svg):
        out.append((float(m.group(1)), float(m.group(2))))
    return out


def _path_endpoints(d):
    tokens = re.findall(r'[MmLlCcSsQqTtHhVvZz]|[-+]?\d*\.?\d+(?:e[-+]?\d+)?', d)
    i = 0
    cur = (0.0, 0.0)
    start = None
    cmd = None

    def num():
        nonlocal i
        v = float(tokens[i]); i += 1; return v

    while i < len(tokens):
        t = tokens[i]
        if re.match(r'[A-Za-z]', t):
            cmd = t; i += 1
        rel = cmd.islower()
        c = cmd.upper()
        if c == 'M':
            x = num(); y = num()
            cur = (cur[0] + x, cur[1] + y) if rel and start else (x, y)
            if start is None:
                start = cur
            cmd = 'l' if rel else 'L'
        elif c == 'L':
            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)
        elif c == 'H':
            x = num(); cur = (cur[0] + x, cur[1]) if rel else (x, cur[1])
        elif c == 'V':
            y = num(); cur = (cur[0], cur[1] + y) if rel else (cur[0], y)
        elif c == 'C':
            num(); num(); num(); num(); x = num(); y = num()
            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)
        elif c == 'S':
            num(); num(); x = num(); y = num()
            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)
        elif c == 'Q':
            num(); num(); x = num(); y = num()
            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)
        elif c == 'T':
            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)
        elif c == 'Z':
            pass
        else:
            i += 1
    return start, cur


def _arrow(start, end):
    dx = end[0] - start[0]; dy = end[1] - start[1]
    ang = math.degrees(math.atan2(dy, dx))
    dirs = [(0, '→'), (45, '↘'), (90, '↓'), (135, '↙'),
            (180, '←'), (-135, '↖'), (-90, '↑'), (-45, '↗')]
    best = min(dirs, key=lambda d: abs((ang - d[0] + 180) % 360 - 180))
    return best[1]


def _build_stroke_svg(paths, nums):
    n = len(paths)
    cols = 6
    rows = math.ceil(n / cols)
    W = 8 + cols * 117
    H = 26 + rows * 117
    out = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" width="{W}" height="{H}">']
    out.append('<rect width="100%" height="100%" fill="#ffffff"/>')
    for i in range(n):
        col = i % cols; row = i // cols
        tx = 8 + col * 117; ty = 26 + row * 117
        out.append(f'<g transform="translate({tx},{ty})"><rect x="0" y="0" width="109" height="109" fill="none" stroke="#eeeeee" stroke-width="1"/>')
        for j in range(i + 1, n):
            out.append(f'<path d="{paths[j]}" stroke="#d6d6d6" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>')
        for j in range(0, i):
            out.append(f'<path d="{paths[j]}" stroke="#1a1a1a" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>')
        out.append(f'<path d="{paths[i]}" stroke="#000000" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>')
        s, e = _path_endpoints(paths[i])
        ar = _arrow(s, e)
        lx, ly = nums[i] if i < len(nums) else (max(6, s[0] - 4), max(8, s[1] - 4))
        out.append(f'<text x="{lx:.2f}" y="{ly:.2f}" font-family="sans-serif" font-size="9" font-weight="bold" fill="#cc0033">{i + 1}{ar}</text></g>')
    out.append('</svg>')
    return "\n".join(out), n


def fetch_stroke_svg(char):
    """Récupère + construit la grille de traits KanjiVG pour un caractère. None si échec réseau."""
    try:
        svg_src = urllib.request.urlopen(KANJIVG_URL.format(cp=_codepoint(char)), timeout=20).read().decode("utf-8")
    except Exception:
        return None, 0
    paths = _parse_paths(svg_src)
    nums = _parse_numbers(svg_src)
    return _build_stroke_svg(paths, nums)

